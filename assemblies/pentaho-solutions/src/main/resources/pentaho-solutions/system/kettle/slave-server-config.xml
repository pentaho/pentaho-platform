<slave_config>
  <max_log_lines>10000</max_log_lines>
  <max_log_timeout_minutes>2880</max_log_timeout_minutes>
  <object_timeout_minutes>240</object_timeout_minutes>

  <!--
      Defines the endpoints security that are available from Kettle Status page
    -->
  <role-bindings>
    <role-binding>
      <context-pattern>\/start.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/stop.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/pause.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/remove.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/execute.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/run.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/prepareExec.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/add.*</context-pattern>
      <require>org.pentaho.repository.create</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/register.*</context-pattern>
      <require>org.pentaho.repository.create</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/status.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/transStatus.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/jobStatus.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/transImage.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/jobImage.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/sniffStep.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/cleanupTrans.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/allocateSocket.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/listSocket.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/nextSequence.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/getSlaves.*</context-pattern>
      <require>org.pentaho.security.administerSecurity</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/properties.*</context-pattern>
      <require>org.pentaho.security.administerSecurity</require>
    </role-binding>
  </role-bindings>

</slave_config> 
