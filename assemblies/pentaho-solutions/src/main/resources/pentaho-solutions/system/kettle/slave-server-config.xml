<slave_config>
  <max_log_lines>10000</max_log_lines>
  <max_log_timeout_minutes>2880</max_log_timeout_minutes>
  <object_timeout_minutes>240</object_timeout_minutes>

  <!--
      Defines the endpoints security that are available from Kettle Status page
    -->
  <role-bindings>
    <role-binding>
      <context-pattern>\/start.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/stop.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/pause.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
    <role-binding>
      <context-pattern>\/remove.*</context-pattern>
      <require>org.pentaho.repository.execute</require>
    </role-binding>
  </role-bindings>

  <!--
    Default behavior for direct job/trans execution URLs is deny-by-default for
    non-pvfs schemes. The default allowlist is intentionally minimal: only
    pvfs:// is permitted unless you explicitly add more schemes here.
    Local paths without a scheme still require 'file' to be included.
  -->
  <allowedExecuteFileSchemes>
    <scheme>pvfs</scheme>
  </allowedExecuteFileSchemes>

</slave_config> 